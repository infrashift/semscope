# semscope development gates in zmake syntax, with `@name:` tasks. zmake reads
# this file before the Makefile. The Makefile holds the same tasks in plain GNU Make syntax.
# Run `zmake check` for the ZMakefile. Run `zmake -f Makefile check` for the Makefile.

GO ?= go
PYTHON ?= python3
BUN ?= bun
ZIG ?= zig
# The ztree checkout. go.mod points its replace directive here (ADR-0013).
ZTREE_DIR ?= ../ztree
GOLANGCI_LINT ?= $(shell $(GO) env GOPATH)/bin/golangci-lint
GOFMT ?= $(shell $(GO) env GOROOT)/bin/gofmt
GO_DIRS := cmd internal rules
PREFIX ?= $(HOME)/.local
# lexiscope checks the Markdown documentation against ASD-STE100 with the
# vocabulary.cue of this repository (ADR-0015). docs-lexiscope runs it only
# when it is on the PATH, so semscope does not depend on lexiscope. Each
# finding fails it. lexis is a short alias of lexiscope.
LEXISCOPE ?= lexiscope
DOCS_LEXISCOPE_PATHS := README.md CLAUDE.md PLAN.md docs/src/content/docs .okfw
DOCS_LEXISCOPE_FLAGS := --ruleset ste-100 --ruleset vocabulary.cue --fail-on note \
	--exclude .okfw/daily --exclude .okfw/ephemeral --exclude index.md --exclude log.md
PARITY_CORPUS ?= $(shell $(PYTHON) -I scripts/parity_corpora.py zig)
PARITY_GO_CORPUS ?= $(shell $(PYTHON) -I scripts/parity_corpora.py go)
VERSION_PKG := github.com/infrashift/semscope/internal/version
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
COMMIT ?= $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
BUILD_DATE ?= $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS := -X $(VERSION_PKG).Version=$(VERSION) -X $(VERSION_PKG).Commit=$(COMMIT) -X $(VERSION_PKG).BuildDate=$(BUILD_DATE)

## all: run every gate (the default goal)
@all: check

## ztree: build libztree.a in the ztree checkout (cgo links it)
@ztree:
    cd $(ZTREE_DIR) && $(ZIG) build lib --release

## build: compile the semscope binary into bin/
@build: ztree
    $(GO) build -trimpath -ldflags "$(LDFLAGS)" -o bin/semscope ./cmd/semscope

## install: copy the semscope binary to $(PREFIX)/bin
@install: build
    install -d $(PREFIX)/bin
    install -m 0755 bin/semscope $(PREFIX)/bin/semscope

## test: run the unit tests with the race detector
@test: ztree
    $(GO) test -race ./...

## lint: check the formatting, the Power of 10 rules and the static analyzers
@lint: ztree
    @out=$$($(GOFMT) -l $(GO_DIRS)); test -z "$$out" || { echo "gofmt: $$out"; exit 1; }
    $(PYTHON) -I scripts/nasa-lint.py
    $(PYTHON) -I scripts/nasa-lint-go.py
    $(PYTHON) -I scripts/tests/nasa_lint_go_test.py
    $(GO) vet ./...
    $(GOLANGCI_LINT) run

## fmt: format the Go sources in place
@fmt:
    $(GOFMT) -w $(GO_DIRS)

## docs-style: check the documentation against ASD-STE100 rules
@docs-style:
    $(PYTHON) -I scripts/ste-check.py --strict

## docs-lexiscope: check the Markdown documentation with lexiscope and vocabulary.cue (each finding fails)
@docs-lexiscope:
    if command -v $(LEXISCOPE) >/dev/null 2>&1; then $(LEXISCOPE) scan $(DOCS_LEXISCOPE_FLAGS) $(DOCS_LEXISCOPE_PATHS); else echo "docs-lexiscope: $(LEXISCOPE) not found, so ste-check.py checks the documentation alone"; fi

## docs-dev: run the Astro Starlight site locally (bun)
@docs-dev:
    cd docs && $(BUN) install && $(BUN) --bun run dev

## docs-dev-up: start the site in the background (astro dev --background)
@docs-dev-up:
    cd docs && $(BUN) install && $(BUN) --bun run astro dev --background
    @echo "docs: $$($(PYTHON) -I -c 'import json; print(json.load(open("docs/.astro/dev.json"))["url"] + "/semscope/")')"

## docs-dev-down: stop the site server of docs-dev or docs-dev-up (astro dev stop)
@docs-dev-down:
    cd docs && $(BUN) --bun run astro dev stop

## docs-build: build the site into docs/dist (the same build as the Pages deploy)
@docs-build:
    cd docs && $(BUN) install --frozen-lockfile && $(BUN) --bun run build

## wiki: validate the OKF wiki
@wiki:
    okfw validate --all
    okfw validate --okf

## selfscan: scan the semscope sources with semscope and the overlay .semscope.cue
@selfscan: ztree
    $(GO) run ./cmd/semscope scan -r nasa-p10 -r .semscope.cue --fail-level warning .

## sarif: write the SARIF 2.1.0 and 2.2 reports of the semscope repository
@sarif: build
    ./bin/semscope scan -r nasa-p10 -r .semscope.cue --format sarif --sarif-version 2.1.0 -o semscope-self.sarif .
    ./bin/semscope scan -r nasa-p10 -r .semscope.cue --format sarif --sarif-version 2.2 -o semscope-self-v22.sarif .

## parity: compare semscope with the oracles on the Zig and Go corpora (ADR-0005, scripts/parity_corpora.py)
@parity: ztree
    SEMSCOPE_PARITY_CORPUS="$(PARITY_CORPUS)" SEMSCOPE_PARITY_GO_CORPUS="$(PARITY_GO_CORPUS)" $(GO) test -count=1 -timeout 900s -run NasaParityCorpus -v ./internal/engine/

## check: run every gate
@check: lint test wiki docs-style docs-lexiscope selfscan
